{
  "schemaVersion": 1,
  "name": "Blue Whale",
  "author": "Clawd design prototype",
  "version": "0.1.0",
  "description": "Original pixel-art blue whale with CSS-animated SVGs for every desktop-pet state.",
  "customization": {
    "petTint": false
  },
  "viewBox": {
    "x": -15,
    "y": -25,
    "width": 45,
    "height": 45
  },
  "layout": {
    "contentBox": {
      "x": -4,
      "y": 4,
      "width": 23,
      "height": 13
    },
    "centerX": 7.5,
    "baselineY": 17,
    "visibleHeightRatio": 0.58,
    "baselineBottomRatio": 0.05
  },
  "eyeTracking": {
    "enabled": true,
    "states": [
      "idle"
    ],
    "eyeRatioX": 0.65,
    "eyeRatioY": 0.46,
    "maxOffset": 1.2,
    "bodyScale": 0.24,
    "shadowStretch": 0.12,
    "shadowShift": 0.2,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js"
    },
    "shadowOrigin": "7.5px 15px"
  },
  "states": {
    "idle": [
      "whale-idle.svg"
    ],
    "roam": [
      "whale-roam.svg"
    ],
    "yawning": [
      "whale-yawning.svg"
    ],
    "dozing": [
      "whale-dozing.svg"
    ],
    "collapsing": [
      "whale-collapsing.svg"
    ],
    "thinking": [
      "whale-thinking.svg"
    ],
    "working": [
      "whale-typing.svg"
    ],
    "juggling": [
      "whale-juggling.svg"
    ],
    "sweeping": [
      "whale-sweeping.svg"
    ],
    "error": [
      "whale-error.svg"
    ],
    "attention": [
      "whale-attention.svg"
    ],
    "notification": [
      "whale-notification.svg"
    ],
    "carrying": [
      "whale-carrying.svg"
    ],
    "sleeping": [
      "whale-sleeping.svg"
    ],
    "waking": [
      "whale-waking.svg"
    ],
    "dizzy": [
      "whale-dizzy.svg"
    ]
  },
  "sleepSequence": {
    "mode": "full"
  },
  "workingTiers": [
    {
      "minSessions": 3,
      "file": "whale-building.svg"
    },
    {
      "minSessions": 2,
      "file": "whale-juggling.svg"
    },
    {
      "minSessions": 1,
      "file": "whale-typing.svg"
    }
  ],
  "idleAnimations": [
    {
      "file": "whale-idle-look.svg",
      "duration": 6500
    },
    {
      "file": "whale-idle-bubbles.svg",
      "duration": 9000
    }
  ],
  "timings": {
    "minDisplay": {
      "attention": 1800,
      "error": 3000,
      "notification": 1800,
      "carrying": 1800,
      "working": 900,
      "thinking": 900
    },
    "autoReturn": {
      "attention": 1800,
      "error": 3600,
      "notification": 1800,
      "carrying": 2400,
      "dizzy": 6000
    },
    "yawnDuration": 2800,
    "collapseDuration": 1250,
    "wakeDuration": 1650,
    "deepSleepTimeout": 600000,
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  },
  "hitBoxes": {
    "default": {
      "x": -4,
      "y": 4,
      "w": 24,
      "h": 13
    },
    "sleeping": {
      "x": -4,
      "y": 8,
      "w": 26,
      "h": 9
    },
    "wide": {
      "x": -5,
      "y": 2,
      "w": 29,
      "h": 15
    }
  },
  "wideHitboxFiles": [
    "whale-attention.svg",
    "whale-notification.svg",
    "whale-error.svg",
    "whale-carrying.svg",
    "whale-building.svg"
  ],
  "sleepingHitboxFiles": [
    "whale-yawning.svg",
    "whale-dozing.svg",
    "whale-collapsing.svg",
    "whale-sleeping.svg",
    "whale-waking.svg"
  ],
  "reactions": {
    "drag": {
      "file": "whale-react-drag.svg",
      "duration": 900
    },
    "clickLeft": {
      "file": "whale-react-left.svg",
      "duration": 900
    },
    "clickRight": {
      "file": "whale-react-right.svg",
      "duration": 900
    },
    "double": {
      "files": [
        "whale-react-double.svg"
      ],
      "duration": 2200
    },
    "annoyed": {
      "file": "whale-react-annoyed.svg",
      "duration": 1400
    }
  },
  "miniMode": {
    "supported": true,
    "offsetRatio": 0.486,
    "states": {
      "mini-idle": [
        "whale-mini-idle.svg"
      ],
      "mini-enter": [
        "whale-mini-enter.svg"
      ],
      "mini-enter-sleep": [
        "whale-mini-enter-sleep.svg"
      ],
      "mini-crabwalk": [
        "whale-mini-crabwalk.svg"
      ],
      "mini-peek": [
        "whale-mini-peek.svg"
      ],
      "mini-alert": [
        "whale-mini-alert.svg"
      ],
      "mini-happy": [
        "whale-mini-happy.svg"
      ],
      "mini-sleep": [
        "whale-mini-sleep.svg"
      ],
      "mini-working": [
        "whale-mini-working.svg"
      ]
    },
    "timings": {
      "minDisplay": {
        "mini-alert": 1800,
        "mini-happy": 2200
      },
      "autoReturn": {
        "mini-alert": 1800,
        "mini-happy": 2200
      }
    }
  }
}
